{
  "name": "SYS 5100 team model (sysml-kit)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem" }
  },
  "containerEnv": { "SYSML_PILOT_VERSION": "0.62.0" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["sensmetry.syside-editor"],
      "settings": { "files.associations": { "*.sysml": "sysml" } }
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
